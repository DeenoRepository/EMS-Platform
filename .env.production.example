# ==============================================================================
# EMS Platform — Production Environment Variables Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.production or set variables in your CI/CD runner.
# Never commit real production secrets and passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_COMPLEX_PASSWORD_64CHARS
POSTGRES_DB=ems_production
# Full Prisma connection string (Used by Web application)
DATABASE_URL="postgresql://ems_admin:CHANGE_ME_TO_STRONG_COMPLEX_PASSWORD_64CHARS@postgres:5432/ems_production?schema=public&connection_limit=50&pool_timeout=20"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=GENERATE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS_HERE
JWT_EXPIRES_IN=8h
JWT_EXPIRATION=8h

# ------------------------------------------------------------------------------
# 4. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
# Directory inside container or persistent volume path
UPLOAD_DIR=/app/uploads
STORAGE_LOCAL_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------------------
# 5. ENTERPRISE LDAP / ACTIVE DIRECTORY (Optional)
# ------------------------------------------------------------------------------
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.company.local:636
LDAP_BIND_DN=cn=ems_service,ou=Services,dc=company,dc=local
LDAP_BIND_PASSWORD=LDAP_SERVICE_ACCOUNT_PASSWORD
LDAP_SEARCH_BASE=dc=company,dc=local
LDAP_SEARCH_FILTER=(|(sAMAccountName={{username}})(uid={{username}})(userPrincipalName={{username}}))

# ------------------------------------------------------------------------------
# 6. EXTERNAL SERVICEDESK / SRM INTEGRATION (Optional)
# Options: JIRA, REDMINE, GITLAB, GENERIC_REST, DISABLED
# ------------------------------------------------------------------------------
SRM_PROVIDER_TYPE=DISABLED
SRM_PROVIDER_URL=https://jira.company.local
SRM_PROJECT_KEY=EMS
SRM_API_KEY=
SRM_CUSTOM_FIELD_ID=customfield_10100

# ------------------------------------------------------------------------------
# 7. LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_RATE_LIMIT=true
