generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ПОЛЬЗОВАТЕЛИ, РОЛИ И ПРАВА (RBAC)
// ==========================================

model User {
  id           String    @id @default(uuid())
  ldapLogin    String    @unique
  displayName  String
  email        String?
  passwordHash String?   // Для локальных/резервных аккаунтов (admin)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roles             UserRole[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  createdEquipment  Equipment[]           @relation("CreatedBy")
  uploadedDocs      Document[]            @relation("UploadedDocs")
  uploadedPhotos    Photo[]               @relation("UploadedPhotos")
  stockOperations   StockOperation[]
  inventories       Inventory[]
  completedSchedules MaintenanceSchedule[] @relation("CompletedBy")
  requestedApprovals EquipmentApproval[]   @relation("ApprovalRequester")
  reviewedApprovals  EquipmentApproval[]   @relation("ApprovalReviewer")
  createdReportTemplates ReportTemplate[]  @relation("CreatedReportTemplates")
  managedWarehouses      Warehouse[]           @relation("WarehouseResponsible")
  createdTransfers       StockTransfer[]       @relation("TransferCreatedBy")
  dispatchedTransfers    StockTransfer[]       @relation("TransferDispatchedBy")
  receivedTransfers      StockTransfer[]       @relation("TransferReceivedBy")
  rejectedTransfers      StockTransfer[]       @relation("TransferRejectedBy")
  checklistResults       ChecklistResult[]
  createdFeedbackTickets FeedbackTicket[]      @relation("FeedbackCreator")
  assignedFeedbackTickets FeedbackTicket[]     @relation("FeedbackAssignee")
  feedbackComments       FeedbackComment[]     @relation("FeedbackAuthor")
  uploadedFeedbackAttachments FeedbackAttachment[] @relation("FeedbackAttachmentUploader")
  requestedPurchaseRequests PurchaseRequest[]  @relation("PurchaseRequestRequester")
  reviewedPurchaseRequests  PurchaseRequest[]  @relation("PurchaseRequestReviewer")
  createdPurchaseDeliveries PurchaseDelivery[] @relation("PurchaseDeliveryCreatedBy")

  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin, guest, engineer, warehouse_manager, etc.
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // eps.equipment.view, wms.stock.manage, etc.
  displayName String
  module      String   // eps, wms, srm, mro, admin, system
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ==========================================
// 2. АУДИТ, УВЕДОМЛЕНИЯ И НАСТРОЙКИ
// ==========================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String      // Equipment, Document, StockOperation, Role, etc.
  entityId   String
  changes    Json?       // { field: { old: "...", new: "..." } }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  MAINTENANCE_UPCOMING
  MAINTENANCE_MISSED
  LOW_STOCK
  SLA_BREACH
  EQUIPMENT_CHANGED
  SYSTEM
  FEEDBACK_CREATED
  FEEDBACK_STATUS_CHANGED
  FEEDBACK_REPLY
  PURCHASE_REQUEST_SUBMITTED
  PURCHASE_REQUEST_APPROVED
  PURCHASE_REQUEST_REJECTED
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model ReportTemplate {
  id          String   @id @default(uuid())
  module      String   @default("eps") // eps, wms, srm, mro
  name        String
  description String?
  config      Json     // { selectedColumns: string[], filters: any, sort: any, title: string }
  isPublic    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CreatedReportTemplates", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([module])
  @@index([createdById])
  @@index([createdAt])
}

// ==========================================
// 3. EPS — ПАСПОРТИЗАЦИЯ ОБОРУДОВАНИЯ
// ==========================================

model Equipment {
  id              String          @id @default(uuid())
  name            String
  inventoryNumber String?         @unique
  serialNumber    String?
  manufacturer    String?
  model           String?
  location        String?
  status          EquipmentStatus @default(ACTIVE)
  commissionDate  DateTime?
  customFields    Json?           // { [fieldKey: string]: any }
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  createdById     String

  createdBy        User                  @relation("CreatedBy", fields: [createdById], references: [id])
  tags             EquipmentTag[]
  documents        Document[]
  photos           Photo[]
  spareParts       EquipmentSparePart[]
  maintenancePlans MaintenancePlan[]
  stockUsage       StockOperationItem[]
  schedules        MaintenanceSchedule[]
  approvals        EquipmentApproval[]
  purchaseRequests PurchaseRequest[]

  @@index([status])
  @@index([name])
  @@index([manufacturer])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

enum EquipmentStatus {
  ACTIVE
  UNDER_REPAIR
  DECOMMISSIONED
  IN_STORAGE
  DRAFT
  INACTIVE
}

model Tag {
  id        String         @id @default(uuid())
  name      String         @unique
  color     String?        // HEX color or MUI color code
  createdAt DateTime       @default(now())
  equipment EquipmentTag[]
}

model EquipmentTag {
  equipmentId String
  tagId       String

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([equipmentId, tagId])
  @@index([tagId])
}

model CustomSection {
  id          String                  @id @default(uuid())
  code        String                  @unique // slug, e.g. "electrical", "hydraulic"
  name        String                  // UI display name, e.g. "Электротехнические параметры"
  description String?
  icon        String?                 // Icon identifier
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  fields      CustomFieldDefinition[]

  @@index([sortOrder])
}

model CustomFieldDefinition {
  id           String         @id @default(uuid())
  sectionId    String?
  section      CustomSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  key          String         @unique // slug for JSON key, e.g. "operating_temperature"
  name         String         // UI Display label
  fieldType    FieldType
  unit         String?        // Unit of measurement, e.g. "кВт", "бар", "В", "кг", "мм"
  isRequired   Boolean        @default(false)
  defaultValue String?
  options      Json?          // string[] for SELECT type
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([sectionId])
  @@index([sortOrder])
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model Document {
  id           String       @id @default(uuid())
  equipmentId  String
  fileName     String       // stored filename on disk
  originalName String       // original upload filename
  filePath     String       // relative path from upload root
  fileType     String       // mime-type
  fileSize     Int          // in bytes
  docType      DocumentType @default(OTHER)
  version      Int          @default(1)
  description  String?
  uploadedById String
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("UploadedDocs", fields: [uploadedById], references: [id])

  @@index([equipmentId])
  @@index([docType])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([deletedAt])
}

enum DocumentType {
  SCHEMA
  MANUAL
  CERTIFICATE
  PASSPORT
  ACT
  OTHER
}

model Photo {
  id            String   @id @default(uuid())
  equipmentId   String
  fileName      String
  originalName  String
  filePath      String
  thumbnailPath String?
  sortOrder     Int      @default(0)
  isPrimary     Boolean  @default(false)
  uploadedById  String
  createdAt     DateTime @default(now())

  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("UploadedPhotos", fields: [uploadedById], references: [id])

  @@index([equipmentId])
}

model EquipmentApproval {
  id                 String             @id @default(uuid())
  equipmentId        String?
  type               ApprovalType
  status             ApprovalStatus     @default(PENDING)
  title              String
  description        String?
  proposedData       Json?
  requesterId        String
  reviewerId         String?
  reviewedAt         DateTime?
  resolutionComment String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requester User      @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer  User?     @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([equipmentId])
  @@index([status])
  @@index([type])
  @@index([requesterId])
  @@index([createdAt])
}

enum ApprovalType {
  EQUIPMENT_CREATE
  EQUIPMENT_UPDATE
  EQUIPMENT_DELETE
  DOCUMENT_CREATE
  DOCUMENT_DELETE
  COMMISSIONING
  DECOMMISSIONING
  STATUS_CHANGE
  PARAMETER_CHANGE
  DOCUMENT_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==========================================
// 4. WMS — СКЛАДСКОЙ УЧЕТ
// ==========================================

model Warehouse {
  id                String    @id @default(uuid())
  name              String
  code              String    @unique
  location          String?
  responsibleUserId String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  responsibleUser     User?               @relation("WarehouseResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  stockItems          StockItem[]
  operations          StockOperation[]
  inventories         Inventory[]
  zones               StorageZone[]
  dispatchedTransfers StockTransfer[]     @relation("TransfersDispatched")
  receivedTransfers   StockTransfer[]     @relation("TransfersReceived")
  usedInMaintenance   MaintenanceUsedPart[]
  purchaseRequests    PurchaseRequest[]
  purchaseDeliveries  PurchaseDelivery[]

  @@index([responsibleUserId])
  @@index([deletedAt])
}

model StorageZone {
  id          String        @id @default(uuid())
  warehouseId String
  name        String
  code        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cells     StorageCell[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model StorageCell {
  id            String              @id @default(uuid())
  zoneId        String
  code          String              // e.g. "A-01", "Стеллаж 1 / Полка 2"
  name          String?             // Описание / наименование ячейки
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  zone          StorageZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  stockItems    StockItem[]
  transferItems StockTransferItem[]

  @@unique([zoneId, code])
  @@index([zoneId])
}

model NomenclatureCategory {
  id        String                 @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime               @default(now())

  parent   NomenclatureCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NomenclatureCategory[] @relation("CategoryHierarchy")
  items    Nomenclature[]
}

model Nomenclature {
  id          String   @id @default(uuid())
  name        String
  article     String?  @unique
  unit        String   @default("шт") // шт, кг, м, л
  categoryId  String?
  description String?
  minStock    Decimal? @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  category          NomenclatureCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockItems        StockItem[]
  operationItems    StockOperationItem[]
  equipmentLinks    EquipmentSparePart[]
  inventoryItems    InventoryItem[]
  transferItems     StockTransferItem[]
  usedInMaintenance MaintenanceUsedPart[]
  purchaseRequestItems PurchaseRequestItem[]

  @@index([name])
  @@index([article])
  @@index([deletedAt])
}

model StockItem {
  id             String   @id @default(uuid())
  warehouseId    String
  nomenclatureId String
  quantity       Decimal  @default(0)
  cellId         String?  // Привязанная ячейка адресного хранения
  updatedAt      DateTime @updatedAt

  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)
  cell         StorageCell? @relation(fields: [cellId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, nomenclatureId])
  @@index([cellId])
}

model StockOperation {
  id           String        @id @default(uuid())
  warehouseId  String
  type         OperationType
  date         DateTime      @default(now())
  counterparty String?       // Поставщик или получатель
  document     String?       // Документ-основание (накладная, акт)
  comment      String?
  createdById  String
  createdAt    DateTime      @default(now())

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdById], references: [id])
  items     StockOperationItem[]
  purchaseDelivery PurchaseDelivery?

  @@index([warehouseId])
  @@index([date])
}

enum OperationType {
  RECEIPT
  ISSUE
  ISSUE_EMPLOYEE
  ISSUE_WRITE_OFF
  TRANSFER
  ADJUSTMENT
}

model StockOperationItem {
  id             String   @id @default(uuid())
  operationId    String
  nomenclatureId String
  quantity       Decimal
  equipmentId    String?  // Списание на конкретное оборудование

  operation    StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature   @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)
  equipment    Equipment?     @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([operationId])
  @@index([nomenclatureId])
  @@index([equipmentId])
}

model EquipmentSparePart {
  equipmentId    String
  nomenclatureId String

  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)

  @@id([equipmentId, nomenclatureId])
  @@index([nomenclatureId])
}

model Inventory {
  id          String          @id @default(uuid())
  warehouseId String
  status      InventoryStatus @default(DRAFT)
  date        DateTime        @default(now())
  comment     String?
  createdById String
  closedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id])
  items     InventoryItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([createdById])
  @@index([date])
}

enum InventoryStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model InventoryItem {
  id             String   @id @default(uuid())
  inventoryId    String
  nomenclatureId String
  expectedQty    Decimal
  actualQty      Decimal?
  diffQty        Decimal?
  comment        String?

  inventory    Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, nomenclatureId])
  @@index([nomenclatureId])
}

// ==========================================
// 4.1. МЕЖСКЛАДСКИЕ ПЕРЕМЕЩЕНИЯ И ЗАПРОСЫ ТМЦ
// ==========================================

model StockTransfer {
  id                String              @id @default(uuid())
  transferNumber    String              @unique // TR-2026-0001
  sourceWarehouseId String
  targetWarehouseId String
  status            StockTransferStatus @default(IN_TRANSIT)

  // Инициатор создания (отправитель при отгрузке или получатель при заявке)
  createdById       String
  requestReason     String?             @db.Text

  // Отправка (согласование / отгрузка со склада-отправителя)
  dispatchedAt      DateTime?
  dispatchedById    String?

  // Приемка (подтверждение приемки на складе-получателе)
  receivedAt        DateTime?
  receivedById      String?

  // Отклонение (с фиксацией обязательной причины отказа)
  rejectedAt        DateTime?
  rejectedById      String?
  rejectionReason   String?             @db.Text

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sourceWarehouse   Warehouse           @relation("TransfersDispatched", fields: [sourceWarehouseId], references: [id], onDelete: Cascade)
  targetWarehouse   Warehouse           @relation("TransfersReceived", fields: [targetWarehouseId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  dispatchedBy      User?               @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy        User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  rejectedBy        User?               @relation("TransferRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  items             StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([status])
  @@index([createdAt])
}

enum StockTransferStatus {
  REQUESTED    // Запрос от получателя, ожидает согласования и отгрузки
  IN_TRANSIT   // Отправлено, ожидает подтверждения приемки получателем
  COMPLETED    // Принято получателем (проведено на склад)
  REJECTED     // Отклонено с указанием причины
  CANCELLED    // Отозвано инициатором
}

model StockTransferItem {
  id             String        @id @default(uuid())
  transferId     String
  nomenclatureId String
  quantity       Decimal
  targetCellId   String?       // Ячейка зачисления на складе-получателе

  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  nomenclature   Nomenclature  @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)
  targetCell     StorageCell?  @relation(fields: [targetCellId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([nomenclatureId])
}

// ==========================================
// 4.2. PRM — ЗАЯВКИ НА ЗАКУПКУ ТМЦ
// ==========================================

model PurchaseRequest {
  id                    String                  @id @default(uuid())
  requestNumber         String                  @unique // PR-20260902-A1B2C3
  status                PurchaseRequestStatus   @default(DRAFT)
  priority              PurchaseRequestPriority @default(MEDIUM)
  targetWarehouseId     String
  requesterId           String
  reviewerId            String?
  reviewedAt            DateTime?
  resolutionComment     String?                 @db.Text
  justification         String?                 @db.Text
  supplierName          String?
  requiredByDate        DateTime?
  equipmentId           String?
  maintenanceScheduleId String?
  estimatedTotal        Decimal                 @default(0)
  currency              String                  @default("RUB")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  targetWarehouse     Warehouse             @relation(fields: [targetWarehouseId], references: [id])
  requester           User                  @relation("PurchaseRequestRequester", fields: [requesterId], references: [id])
  reviewer            User?                 @relation("PurchaseRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  equipment           Equipment?            @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  maintenanceSchedule MaintenanceSchedule?  @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)
  items               PurchaseRequestItem[]
  deliveries          PurchaseDelivery[]

  @@index([status])
  @@index([targetWarehouseId])
  @@index([requesterId])
  @@index([equipmentId])
  @@index([maintenanceScheduleId])
  @@index([createdAt])
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  IN_PROGRESS
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
}

enum PurchaseRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PurchaseRequestItem {
  id             String   @id @default(uuid())
  requestId      String
  nomenclatureId String
  requestedQty   Decimal
  estimatedPrice Decimal  @default(0)
  actualPrice    Decimal?
  receivedQty    Decimal  @default(0)
  comment        String?

  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature    @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)
  deliveryItems PurchaseDeliveryItem[]

  @@index([requestId])
  @@index([nomenclatureId])
}

model PurchaseDelivery {
  id              String   @id @default(uuid())
  requestId       String
  warehouseId     String
  deliveryDate    DateTime @default(now())
  supplierName    String?
  document        String?
  idempotencyKey  String   @unique
  createdById     String
  stockOperationId String  @unique
  createdAt       DateTime @default(now())

  request        PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("PurchaseDeliveryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  stockOperation StockOperation  @relation(fields: [stockOperationId], references: [id], onDelete: Restrict)
  items          PurchaseDeliveryItem[]

  @@index([requestId])
  @@index([warehouseId])
  @@index([createdById])
  @@index([deliveryDate])
}

model PurchaseDeliveryItem {
  id               String   @id @default(uuid())
  deliveryId       String
  requestItemId    String
  receivedQty      Decimal
  actualPrice      Decimal?

  delivery    PurchaseDelivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  requestItem PurchaseRequestItem  @relation(fields: [requestItemId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, requestItemId])
  @@index([requestItemId])
}

// ==========================================
// 5. SRM — СЕРВИС-ДЕСК И ИНТЕГРАЦИИ (JIRA, REDMINE, 1C, REST)
// ==========================================

model SrmIntegration {
  id             String          @id @default(uuid())
  name           String          // e.g. "Корпоративная Jira SRM", "Redmine IT-отдел", "1С:ТОиР ServiceDesk"
  providerType   SrmProviderType @default(JIRA)
  isActive       Boolean         @default(true)
  isDefault      Boolean         @default(false)
  baseUrl        String          // e.g. "https://jira.company.ru" or "https://redmine.corp.local"
  authType       SrmAuthType     @default(BASIC)
  authConfig     Json            // { username, apiToken, headerName, apiKey, etc. }
  queryConfig    Json            // { endpoint, method, queryParams, defaultJqlOrFilter, headers }
  mappingConfig  Json?           // Схема сопоставления полей (JiraFieldMappingConfig)
  syncInterval   Int             @default(60) // интервал в минутах
  lastSyncAt     DateTime?
  lastSyncStatus String?         // SUCCESS, ERROR
  lastSyncError  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  issues         JiraIssueCache[]
}

enum SrmProviderType {
  JIRA
  REDMINE
  GITLAB_ISSUES
  REST_GENERIC
  SERVICE_NOW
  CUSTOM_WEBHOOK
}

enum SrmAuthType {
  BASIC
  BEARER
  API_KEY
  CUSTOM_HEADERS
  NONE
}

model JiraIssueCache {
  id              String          @id @default(uuid())
  issueKey        String          @unique // e.g. EMS-104, INC-2026-0001, REDMINE-12
  summary         String
  description     String?         @db.Text
  status          String          // OPEN, IN_PROGRESS, RESOLVED, CLOSED, WAITING
  priority        String          // LOW, MEDIUM, HIGH, CRITICAL
  issueType       String          // INCIDENT, SERVICE_REQUEST, REPAIR, MAINTENANCE, DEFECT
  source          String          @default("JIRA") // INTERNAL, JIRA, REDMINE, 1C, GITLAB, WEBHOOK
  failureCategory String?         // MECHANICAL, ELECTRICAL, HYDRAULIC, SOFTWARE, OPERATOR_ERROR, WEAR, OTHER
  downtimeMinutes Int?            // Время простоя оборудования в минутах
  slaDeadline     DateTime?       // Плановое время решения по регламенту SLA
  slaBreached     Boolean?        @default(false)
  resolutionNotes String?         @db.Text
  warrantyClaim   Boolean?        @default(false)
  contractorName  String?         // Сервисный подрядчик / СЦ
  mroScheduleId   String?         // Связанный заказ-наряд ТОиР
  assignee        String?
  reporter        String?
  createdById     String?         // Внутренний пользователь-инициатор
  createdDate     DateTime
  resolvedDate    DateTime?
  equipmentId     String?         // Сопоставленное оборудование
  integrationId   String?         // Ссылка на источник интеграции
  rawData         Json?           // Полный исходный JSON (или кастомные параметры)
  syncedAt        DateTime        @default(now())

  integration     SrmIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([failureCategory])
  @@index([equipmentId])
  @@index([integrationId])
  @@index([source])
  @@index([createdDate])
  @@index([slaDeadline])
}

// ==========================================
// 6. MRO — ТЕХНИЧЕСКОЕ ОБСЛУЖИВАНИЕ И РЕМОНТ
// ==========================================

model MaintenancePlan {
  id           String               @id @default(uuid())
  equipmentId  String
  name         String
  description  String?
  frequency    MaintenanceFrequency
  intervalDays Int?
  checklistId  String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  equipment Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  checklist ChecklistTemplate?  @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  schedules MaintenanceSchedule[]

  @@index([equipmentId])
  @@index([checklistId])
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model MaintenanceSchedule {
  id            String            @id @default(uuid())
  planId        String?
  equipmentId   String
  title         String
  scheduledDate DateTime
  status        MaintenanceStatus @default(PLANNED)
  completedDate DateTime?
  completedById String?
  notes         String?
  jiraIssueKey  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  plan            MaintenancePlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  equipment       Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  completedBy     User?                 @relation("CompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  checklistResult ChecklistResult?
  usedParts       MaintenanceUsedPart[]
  purchaseRequests PurchaseRequest[]

  @@index([scheduledDate])
  @@index([status])
  @@index([equipmentId])
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       ChecklistTemplateItem[]
  plans       MaintenancePlan[]
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid())
  templateId  String
  description String
  itemType    ChecklistItemType
  sortOrder   Int               @default(0)
  isRequired  Boolean           @default(true)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

enum ChecklistItemType {
  BOOLEAN
  NUMERIC
  TEXT
}

model ChecklistResult {
  id            String   @id @default(uuid())
  scheduleId    String   @unique
  items         Json     // [{itemId, description, itemType, value, note}]
  completedById String
  completedAt   DateTime @default(now())

  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  completedBy User                @relation(fields: [completedById], references: [id], onDelete: Restrict)

  @@index([completedById])
}

model MaintenanceUsedPart {
  id             String   @id @default(uuid())
  scheduleId     String
  nomenclatureId String
  warehouseId    String
  quantity       Decimal

  schedule     MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  nomenclature Nomenclature        @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([nomenclatureId])
  @@index([warehouseId])
}

// ==========================================
// 7. СИСТЕМА ОБРАТНОЙ СВЯЗИ И ТРЕКИНГА ОШИБОК (FEEDBACK HUB)
// ==========================================

model FeedbackTicket {
  id           String           @id @default(uuid())
  ticketNumber String           @unique // FB-2026-0001
  type         FeedbackType     @default(BUG)
  module       FeedbackModule   @default(GENERAL)
  priority     FeedbackPriority @default(MEDIUM)
  status       FeedbackStatus   @default(NEW)
  title        String
  description  String           @db.Text
  pageUrl      String?
  browserInfo  Json?            // { userAgent, screenResolution, os, browser, language }
  resolution   String?          @db.Text
  resolvedAt   DateTime?
  
  createdById  String
  assignedToId String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  createdBy    User             @relation("FeedbackCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments     FeedbackComment[]
  attachments  FeedbackAttachment[]

  @@index([type])
  @@index([module])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([deletedAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum FeedbackModule {
  EPS
  WMS
  SRM
  MRO
  ADMIN
  GENERAL
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  DUPLICATE
}

model FeedbackComment {
  id         String         @id @default(uuid())
  ticketId   String
  userId     String
  message    String         @db.Text
  isInternal Boolean        @default(false)
  createdAt  DateTime       @default(now())

  ticket     FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User           @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model FeedbackAttachment {
  id           String         @id @default(uuid())
  ticketId     String
  fileName     String
  originalName String
  filePath     String
  fileType     String
  fileSize     Int
  uploadedById String
  createdAt    DateTime       @default(now())

  ticket       FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation("FeedbackAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([uploadedById])
}

