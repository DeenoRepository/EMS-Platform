{
  "name": "@ems/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "echo @ems/database build ok",
    "generate": "prisma generate",
    "push": "prisma db push",
    "push:force": "prisma db push --accept-data-loss",
    "push:reset": "prisma db push --force-reset --accept-data-loss",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:resolve-baseline": "prisma migrate resolve --applied 20260831030000_init",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
