# ==============================================================================
# EMS Platform — Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=ems_db
POSTGRES_PORT=5432
POSTGRES_BIND_IP=0.0.0.0

# Database URL used by Prisma & Next.js backend
# For Docker internal networking use: postgresql://postgres:postgrespassword@postgres:5432/ems_db?schema=public
# For local machine execution use: postgresql://postgres:postgrespassword@127.0.0.1:5432/ems_db?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ems_db?schema=public

# ------------------------------------------------------------------------------
# 2. Server & Web App
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="EMS Platform"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 3. Security & JWT
# ------------------------------------------------------------------------------
# Minimum 32 characters hex/base64 string. Generate using: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_ems_platform_production_change_me_32chars
JWT_EXPIRES_IN=8h
JWT_EXPIRATION=8h

# ------------------------------------------------------------------------------
# 4. Storage (Documents, Drawings, Passports, Photos)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 5. OpenLDAP / Active Directory Integration
# ------------------------------------------------------------------------------
LDAP_ENABLED=true
# For Docker internal OpenLDAP: ldap://ems_ldap:389
# For external Active Directory: ldap://ad.company.local:389 or ldaps://ad.company.local:636
LDAP_URL=ldap://ems_ldap:389
LDAP_PORT=389
LDAP_ADMIN_PASSWORD=adminpassword
LDAP_BIND_DN=cn=admin,dc=company,dc=local
LDAP_BIND_PASSWORD=adminpassword
LDAP_SEARCH_BASE=dc=company,dc=local
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# ------------------------------------------------------------------------------
# 6. SRM / Jira Integration (Optional)
# ------------------------------------------------------------------------------
JIRA_HOST=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=EMS
