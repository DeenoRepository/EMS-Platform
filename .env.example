# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ems_db?schema=public"

# JWT Secret for Session Management
JWT_SECRET="ems-super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="8h"

# LDAP / Active Directory Configuration
# Set LDAP_ENABLED=false for local/dev fallback mode
LDAP_ENABLED="false"
LDAP_URL="ldap://ldap.example.local:389"
LDAP_BIND_DN="cn=admin,dc=example,dc=local"
LDAP_BIND_PASSWORD="secretpassword"
LDAP_SEARCH_BASE="ou=users,dc=example,dc=local"
LDAP_SEARCH_FILTER="(sAMAccountName={{username}})"

# Jira Integration Configuration
JIRA_ENABLED="false"
JIRA_BASE_URL="https://jira.example.local"
JIRA_API_TOKEN=""
JIRA_USER_EMAIL=""
JIRA_PROJECT_KEY="EMS"
JIRA_EQUIPMENT_CUSTOM_FIELD="customfield_10100"

# Application Settings
NEXT_PUBLIC_APP_NAME="EMS — Equipment Management System"
NEXT_PUBLIC_APP_VERSION="1.0.0"
UPLOAD_DIR="./uploads"
PORT=3000
