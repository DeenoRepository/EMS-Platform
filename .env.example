# ==============================================================================
# EMS Platform — Production Environment Configuration Template
# ==============================================================================
#
# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он уже добавлен в .gitignore.
#
# ⚠️  БЕЗОПАСНОСТЬ: Все значения ниже — ПРИМЕРЫ. Замените их перед деплоем!

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
# ✅ Сгенерируйте надёжный пароль: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=ems_db
POSTGRES_PORT=5432
# Для продакшена оставьте 127.0.0.1 (доступен только с localhost/Docker-сети)
# Для внешнего доступа к БД (нежелательно) используйте 0.0.0.0
POSTGRES_BIND_IP=127.0.0.1

# Database URL used by Prisma & Next.js backend
# Для Docker internal networking:  postgresql://postgres:<password>@postgres:5432/ems_db?schema=public
# Для локального запуска:          postgresql://postgres:<password>@127.0.0.1:5432/ems_db?schema=public
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/ems_db?schema=public

# ------------------------------------------------------------------------------
# 2. Server & Web App
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="EMS Platform"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 3. Security & JWT
# ✅ ОБЯЗАТЕЛЬНО сгенерируйте случайный секрет перед деплоем:
#    openssl rand -hex 32
# Минимум 32 символа. Приложение НЕ запустится если обнаружит дефолтное значение.
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
JWT_EXPIRES_IN=8h
JWT_EXPIRATION=8h

# ------------------------------------------------------------------------------
# 4. Storage (Documents, Drawings, Passports, Photos)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 5. OpenLDAP / Active Directory Integration
# ✅ Замените пароли LDAP перед деплоем.
# ------------------------------------------------------------------------------
LDAP_ENABLED=true
# Для Docker internal OpenLDAP: ldap://ems_ldap:389
# Для внешнего Active Directory: ldap://ad.company.local:389 или ldaps://ad.company.local:636
LDAP_URL=ldap://ems_ldap:389
# Разрешенные хосты для серверных LDAP/SRM диагностических запросов (точное совпадение, через запятую).
# Внутренние хосты должны быть указаны явно, например: ems_ldap, jira
OUTBOUND_ALLOWED_HOSTS=ems_ldap
LDAP_PORT=389
# ✅ Сгенерируйте: openssl rand -base64 18
LDAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_LDAP_PASSWORD
LDAP_BIND_DN=cn=admin,dc=company,dc=local
LDAP_BIND_PASSWORD=REPLACE_WITH_STRONG_LDAP_PASSWORD
LDAP_SEARCH_BASE=dc=company,dc=local
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# ------------------------------------------------------------------------------
# 6. SRM / Jira Integration
# ------------------------------------------------------------------------------
# Для локального Jira Mock контейнера (Docker): http://jira:8080 или http://localhost:8080
# Для внешнего сервера: http://jira.company.local:8080
JIRA_ENABLED=true
JIRA_HOST=http://localhost:8080
JIRA_BASE_URL=http://localhost:8080
JIRA_EMAIL=admin@company.local
JIRA_USER_EMAIL=admin@company.local
JIRA_API_TOKEN=adminpassword
JIRA_PROJECT_KEY=GRIO
JIRA_EQUIPMENT_CUSTOM_FIELD=customfield_10100
