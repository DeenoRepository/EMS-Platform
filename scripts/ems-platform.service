[Unit]
Description=EMS Platform — Equipment Management System
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ems
Group=ems
WorkingDirectory=/opt/ems-platform
EnvironmentFile=/opt/ems-platform/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000

# Application startup must never synchronize, migrate, reset, or seed the database.
# Provisioning and schema changes require a separate, explicitly approved procedure.
# Start Next.js Web server
ExecStart=/opt/ems-platform/apps/web/node_modules/.bin/next start /opt/ems-platform/apps/web -p 3000

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ems-platform

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
