+
+mock.module('@ems/shared', {
+  namedExports: {
+    PERMISSIONS: {
+      EPS_EQUIPMENT_VIEW: 'eps.equipment.view',
+      EPS_EQUIPMENT_EDIT: 'eps.equipment.edit',
+      EPS_DOCUMENTS_UPLOAD: 'eps.documents.upload',
+    },
+  },
