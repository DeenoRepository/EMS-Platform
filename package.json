{
  "name": "ems-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "test": "DATABASE_URL=\"postgresql://dummy:dummy@localhost:5432/dummy?schema=public\" tsx --test packages/auth/src/*.test.ts apps/web/src/lib/__tests__/*.test.ts",
    "start:prod": "pnpm --filter @ems/web start",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "prod:ps": "docker compose -f docker-compose.prod.yml ps",
    "db:generate": "pnpm --filter @ems/database generate",
    "db:push": "pnpm --filter @ems/database push",
    "db:migrate": "pnpm --filter @ems/database migrate",
    "db:migrate:deploy": "pnpm --filter @ems/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @ems/database seed",
    "db:studio": "pnpm --filter @ems/database studio",
    "jira:start": "tsx docker/jira/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.23.12",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}

