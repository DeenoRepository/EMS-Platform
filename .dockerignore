# Git
.git
.gitignore

# Dependencies & Build artifacts
node_modules
apps/web/node_modules
packages/*/node_modules
.pnpm-store
.next
apps/*/.next
packages/*/.next
.turbo
apps/*/.turbo
packages/*/.turbo
dist
build
*.tsbuildinfo

# Environment & Secret files
# Правило: исключается ВСЁ семейство .env*, кроме шаблонов *.example.
# Перечисление отдельных вариантов уже приводило к утечке: scripts/prod-deploy.sh
# создаёт в корне репозитория .env.production с реальными JWT_SECRET и паролем
# БД, а `COPY . .` в Dockerfile запекал бы его в слой образа. Секреты
# передаются контейнеру через `environment:` в docker-compose.prod.yml, поэтому
# внутри образа эти файлы не нужны ни на одном этапе сборки.
.env
.env.*
!.env.example
!.env.production.example
.installed

# Logs & temp files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.system_generated
tmp
temp
uploads/*
!uploads/.gitkeep

# Testing & Coverage
coverage
playwright-report
test-results
.nyc_output

# Documentation & Spec drafts
*.csv
*.sql
*.tar.gz
scripts/export_dumps_to_csv.py
